#!/usr/bin/env bash
# Install with: git config core.hooksPath .githooks
# Run the CI checks locally, then mutation-test the staged Rust diff.

set -euo pipefail

# fmt, clippy and the tests read the working tree while the commit is the index, and this is a plain Git hook, so nothing stashes unstaged work first. The two must match, with no untracked inputs. The mutation run builds a snapshot of the index, so it needs no such check.
if ! git diff --quiet -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "pre-commit: the working tree must match the index, with no untracked inputs" >&2
    echo "            stage the intended changes or isolate the commit; no files have been altered" >&2
    exit 1
fi

# Keep in sync with .github/workflows/ci.yml.
CARGO_MUTANTS_VERSION="27.1.0"

echo "pre-commit: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

echo "pre-commit: cargo test --all-features --all"
cargo test --all-features --all

if ! command -v cargo-mutants > /dev/null 2>&1; then
    echo "pre-commit: cargo-mutants is required but not installed." >&2
    echo "            install it with: cargo install cargo-mutants --version '=${CARGO_MUTANTS_VERSION}'" >&2
    exit 1
fi

echo "pre-commit: scripts/mutants-staged.sh"
exec bash ./scripts/mutants-staged.sh
